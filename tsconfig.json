{
    "compilerOptions": {
        "target": "es2023",
        "module": "node16",
        "moduleResolution": "node16",
        "lib": ["es2023"],
        "types": ["node", "mocha"],
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "sourceMap": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
